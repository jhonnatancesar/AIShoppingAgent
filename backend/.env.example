# Development outside Docker may copy this file to .env. Production must use
# the matching AISHOPPING_*_FILE variables and /run/secrets instead.
AISHOPPING_APP_NAME=AIShoppingAgent
AISHOPPING_ENVIRONMENT=development
AISHOPPING_DEBUG=false
AISHOPPING_LOG_LEVEL=INFO
AISHOPPING_OBSERVABILITY_ENABLED=false
AISHOPPING_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
AISHOPPING_TRACE_SAMPLE_RATIO=1.0
AISHOPPING_READINESS_TIMEOUT_SECONDS=1.0
AISHOPPING_MAX_REQUEST_BODY_BYTES=65536
AISHOPPING_TELEGRAM_RATE_LIMIT_PER_MINUTE=20
AISHOPPING_EXTERNAL_HTTP_TIMEOUT_SECONDS=10
# TASK-075 (correção): timeout de navegação do Playwright (page.goto),
# separado do timeout de chamada de API/HTTP externo acima -- só lido pelo
# collection_worker.
AISHOPPING_BROWSER_NAVIGATION_TIMEOUT_SECONDS=45
AISHOPPING_SAFE_RETRY_MAX_ATTEMPTS=3
AISHOPPING_RETRY_BASE_DELAY_SECONDS=0.25
AISHOPPING_RETRY_MAX_DELAY_SECONDS=5
AISHOPPING_RETRY_AFTER_CAP_SECONDS=30
AISHOPPING_CIRCUIT_FAILURE_THRESHOLD=5
AISHOPPING_CIRCUIT_OPEN_SECONDS=30
AISHOPPING_EVENT_CONSUMER_MAX_ATTEMPTS=5
AISHOPPING_EVENT_RETRY_BASE_SECONDS=60
AISHOPPING_EVENT_RETRY_CAP_SECONDS=900
AISHOPPING_WORKER_FAILURE_BACKOFF_SECONDS=5
AISHOPPING_WORKER_METRICS_PORT=9464
AISHOPPING_DATABASE_HOST=localhost
AISHOPPING_DATABASE_PORT=5432
AISHOPPING_DATABASE_NAME=aishoppingagent
AISHOPPING_DATABASE_USER=aishoppingagent
AISHOPPING_DATABASE_PASSWORD=change-this-local-password
AISHOPPING_GEMINI_API_KEY_USER=replace-with-gemini-api-key-for-user
AISHOPPING_GEMINI_API_KEY_ADMIN_DEV=replace-with-gemini-api-key-for-admin-dev
AISHOPPING_GROQ_API_KEY=replace-with-groq-api-key
AISHOPPING_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
AISHOPPING_TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
AISHOPPING_TELEGRAM_NOTIFICATION_POLL_SECONDS=5
AISHOPPING_TELEGRAM_NOTIFICATION_BATCH_SIZE=50
AISHOPPING_AUTH_PUBLIC_BASE_URL=http://localhost:8000
