# Copy this file to .env and adjust local values as needed.
AISHOPPING_APP_NAME=AIShoppingAgent
AISHOPPING_ENVIRONMENT=development
AISHOPPING_DEBUG=false
AISHOPPING_LOG_LEVEL=INFO
AISHOPPING_DATABASE_HOST=localhost
AISHOPPING_DATABASE_PORT=5432
AISHOPPING_DATABASE_NAME=aishoppingagent
AISHOPPING_DATABASE_USER=aishoppingagent
AISHOPPING_DATABASE_PASSWORD=change-this-local-password
AISHOPPING_GEMINI_API_KEY=replace-with-gemini-api-key
AISHOPPING_GEMINI_MODEL=gemini-3.6-flash
AISHOPPING_GEMINI_PREMIUM_MODEL=gemini-3.1-pro-preview
AISHOPPING_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
AISHOPPING_TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
