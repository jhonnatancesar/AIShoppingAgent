# Development outside Docker may copy this file to .env. Production must use
# the matching AISHOPPING_*_FILE variables and /run/secrets instead.
AISHOPPING_APP_NAME=AIShoppingAgent
# César Core é obrigatório para AI, grounding e Search; segredo só por arquivo.
AISHOPPING_CESAR_CORE_SEARCH_TIMEOUT_SECONDS=30
AISHOPPING_CESAR_CORE_API_KEY_FILE=C:/AIShoppingAgent/AIShoppingAgent/.secrets/cesar-core-client-dev
AISHOPPING_CESAR_CORE_BASE_URL=http://127.0.0.1:8100
AISHOPPING_CESAR_CORE_SERVICE=backend
AISHOPPING_CESAR_CORE_SERVICE_CLASS=economy
AISHOPPING_CESAR_CORE_MAX_TOKENS=1024
AISHOPPING_CESAR_CORE_TIMEOUT_SECONDS=90
AISHOPPING_ENVIRONMENT=development
AISHOPPING_DEBUG=false
AISHOPPING_LOG_LEVEL=INFO
AISHOPPING_OBSERVABILITY_ENABLED=false
AISHOPPING_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
AISHOPPING_TRACE_SAMPLE_RATIO=1.0
AISHOPPING_READINESS_TIMEOUT_SECONDS=1.0
AISHOPPING_MAX_REQUEST_BODY_BYTES=65536
AISHOPPING_TELEGRAM_RATE_LIMIT_PER_MINUTE=20
AISHOPPING_EXTERNAL_HTTP_TIMEOUT_SECONDS=10
# TASK-075 (correção): timeout de navegação do Playwright (page.goto),
# separado do timeout de chamada de API/HTTP externo acima -- só lido pelo
# collection_worker.
AISHOPPING_BROWSER_NAVIGATION_TIMEOUT_SECONDS=45
# Opcional: o worker inicia e supervisiona um Edge dedicado em loopback,
# reaproveitado por Magalu, Mercado Livre e Terabyte (TASK-105). Nome antigo
# AISHOPPING_MAGALU_CDP_URL ainda funciona por compatibilidade.
# AISHOPPING_EDGE_CDP_URL=http://127.0.0.1:9223
# AISHOPPING_MAGALU_EDGE_EXECUTABLE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# AISHOPPING_MAGALU_EDGE_PROFILE_DIR=C:\aishoppingagent-runtime\magalu-edge
# AISHOPPING_MAGALU_CDP_CONNECT_TIMEOUT_SECONDS=5
# AISHOPPING_MAGALU_CDP_NAVIGATION_TIMEOUT_SECONDS=20
# AISHOPPING_MAGALU_CDP_DOCUMENT_TIMEOUT_SECONDS=10
# AISHOPPING_MAGALU_CDP_HTML_TIMEOUT_SECONDS=3
AISHOPPING_SAFE_RETRY_MAX_ATTEMPTS=3
AISHOPPING_RETRY_BASE_DELAY_SECONDS=0.25
AISHOPPING_RETRY_MAX_DELAY_SECONDS=5
AISHOPPING_RETRY_AFTER_CAP_SECONDS=30
AISHOPPING_CIRCUIT_FAILURE_THRESHOLD=5
AISHOPPING_CIRCUIT_OPEN_SECONDS=30
AISHOPPING_EVENT_CONSUMER_MAX_ATTEMPTS=5
AISHOPPING_EVENT_RETRY_BASE_SECONDS=60
AISHOPPING_EVENT_RETRY_CAP_SECONDS=900
AISHOPPING_WORKER_FAILURE_BACKOFF_SECONDS=5
AISHOPPING_WORKER_METRICS_PORT=9464
# TASK-109: precisa bater com POSTGRES_PORT do .env raiz (Docker Compose)
# -- se a máquina já tiver um PostgreSQL nativo próprio em 5432, use a
# mesma porta alternativa nos dois arquivos (ex.: 15432).
# TASK-109 (achado real): em worker nativo Windows, "localhost" resolve
# para IPv6 (::1) primeiro -- o Postgres do Docker só publica em IPv4
# (127.0.0.1), então cada conexão nova trava ~130s até cair pro IPv4.
# Use "127.0.0.1" explicitamente para evitar essa demora.
AISHOPPING_DATABASE_HOST=127.0.0.1
AISHOPPING_DATABASE_PORT=5432
AISHOPPING_DATABASE_NAME=aishoppingagent
AISHOPPING_DATABASE_USER=aishoppingagent
AISHOPPING_DATABASE_PASSWORD=change-this-local-password
AISHOPPING_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
AISHOPPING_TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
AISHOPPING_OPS_CONTROLLER_URL=http://localhost:8010
AISHOPPING_OPS_CONTROLLER_SECRET=replace-with-random-ops-controller-secret
AISHOPPING_TELEGRAM_NOTIFICATION_POLL_SECONDS=5
AISHOPPING_TELEGRAM_NOTIFICATION_BATCH_SIZE=50
AISHOPPING_AUTH_PUBLIC_BASE_URL=http://localhost:8000
# FASE G (2026-09-06): feature flags de F1/F3/cupons -- default seguro é
# "false" nos três (comportamento idêntico ao fluxo anterior a essa
# iniciativa). O collection_worker roda nativo (TASK-109) e lê este
# arquivo diretamente -- é aqui, não em compose.yaml, que essas flags
# precisam ser ligadas para valer na coleta real.
# AISHOPPING_HISTORICAL_BOOTSTRAP_ENABLED=false
# AISHOPPING_MARKET_RESEARCH_EXTERNAL_REFERENCE_ENABLED=false
# AISHOPPING_COUPONS_ENABLED=false

# DEC-118 (2026-09-07): cota de missões ativas ADMIN/DEV, independente da
# de USER (AISHOPPING_DEFAULT_MAX_ACTIVE_MISSIONS=5, default do código,
# sem variável própria). Sem esta variável (ou com ela ausente), ADMIN/DEV
# herda o mesmo default do USER -- valor decidido explicitamente pelo
# usuário nesta rodada, não inventado.
AISHOPPING_DEFAULT_MAX_ACTIVE_MISSIONS_ADMIN_DEV=50
