# Copy this file to .env before starting Docker Compose.
# Docker reads secret values from files in this ignored directory.
AISHOPPING_SECRETS_DIR=./.secrets

# Optional non-secret local overrides.
POSTGRES_DB=aishoppingagent
POSTGRES_USER=aishoppingagent
POSTGRES_PORT=5432
AISHOPPING_AUTH_PUBLIC_BASE_URL=http://localhost:8000
API_PORT=8000
AISHOPPING_APP_NAME=AIShoppingAgent
AISHOPPING_ENVIRONMENT=development
AISHOPPING_DEBUG=false
AISHOPPING_LOG_LEVEL=INFO
AISHOPPING_OBSERVABILITY_ENABLED=true
AISHOPPING_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
AISHOPPING_TRACE_SAMPLE_RATIO=1.0
AISHOPPING_READINESS_TIMEOUT_SECONDS=1.0
AISHOPPING_WORKER_METRICS_PORT=9464
AISHOPPING_GEMINI_MODEL=gemini-3.6-flash
AISHOPPING_GEMINI_PREMIUM_MODEL=gemini-3.1-pro-preview
